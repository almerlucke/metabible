package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
    "fmt"
)

templ ChapterPage(book *models.Book, chapter *models.Chapter, verses []*models.Verse, prevChapter string, nextChapter string) {
    <!DOCTYPE html>
    <html lang="en">
        @head(fmt.Sprintf("%s %d", book.BookName, chapter.ChapterNum)) {}
        <body>
        @mainContainer("Chapter") {
            @navArticle(chapterTitleComponent(book, chapter), "/chapter/%s",  prevChapter, nextChapter) {
                <h5>Verses:</h5>
                <ul>
                    for _, verse := range verses {
                        <li><a href={templ.SafeURL(fmt.Sprintf("/verse/%s", verse.ID))}><b>{fmt.Sprintf("(%d)\t", verse.VerseNum)}</b><i>{verse.ShortExcerpt()}</i></a></li>
                    }
                </ul>
            }
        }
        </body>
    </html>
}