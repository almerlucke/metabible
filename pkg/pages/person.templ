package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
)

templ PersonPage(person *models.Person)  {
    <!DOCTYPE html>
    <html lang="en">
        @head(person.DisplayTitle) {}
        <body>
        @mainContainer("Person") {
            @article(person.DisplayTitle) {
                <div>
                    if person.DictText != "" {
                        <md-block>{person.DictText}</md-block>
                    }
                </div>
            }
        }
        </body>
    </html>
}