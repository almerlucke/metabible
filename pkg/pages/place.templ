package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
)

templ PlacePage(place *models.Place) {
    <!DOCTYPE html>
    <html lang="en">
        @head(place.DisplayTitle) {
            if place.HasLocation() {
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
            }
            @templ.JSONScript("place", place)
        }
        <body>
        @mainContainer("Place") {
            @article(place.DisplayTitle) {
                <div>
                    if place.DictText != "" {
                        <md-block id="dictText">{place.DictText}</md-block>
                    }
                </div>
                if place.HasLocation() {
                    <div id="map" style="width: 100%; height: 580px"></div>
                }
            }
        }
        if place.HasLocation() {
            <script type="text/javascript" src="/assets/js/place/place.js"></script>
        }
        </body>
    </html>
}