package pages

import (
	"fmt"

	"github.com/almerlucke/metabible/pkg/atlas"
)

// ---------------------------------------------------------------- shell

templ classic(title string, active string, headExtra templ.Component) {
	<!DOCTYPE html>
	<html lang={ langOf(ctx) } data-theme="dark">
		@atlasHead(title, false) {
			if headExtra != nil {
				@headExtra
			}
		}
		<body class="mb-classic">
			@topNav(active)
			<main class="mb-page" id="main">
				{ children... }
			</main>
			<script src="/assets/js/site/site.js"></script>
		</body>
	</html>
}

templ withMap() {
	<link rel="stylesheet" href="/assets/vendor/maplibre/maplibre-gl.css"/>
	<script src="/assets/vendor/maplibre/maplibre-gl.js"></script>
}

templ miniMap(cfg atlas.MapConfig, class string) {
	<div class={ "mb-minimap", class } data-config={ cfg.JSON() }></div>
	<script type="module" src="/assets/js/atlas/minimap.js"></script>
}

// ---------------------------------------------------------------- shared pieces

templ wikiCard(w *atlas.WikiEntry, photo *atlas.GalleryItem) {
	<div class="card wiki">
		if w.Image != nil && photo != nil {
			<figure class="pic zoom" { lbAttrs(*photo)... } tabindex="0" role="button" aria-label={ t(ctx, "ui.enlarge", "title", w.Title) }>
				<img src={ templ.SafeURL(w.Image.URL) } alt={ w.Title } loading="lazy"/>
				<figcaption><a href={ templ.SafeURL(w.Image.Page) } rel="noopener">{ imgCredit(w.Image) }</a></figcaption>
			</figure>
		}
		<div class="mb-tag">{ t(ctx, "ui.from.wikipedia") }</div>
		if w.Desc != "" {
			<div class="wdesc">{ w.Desc }</div>
		}
		<p>{ w.Summary }</p>
		<a href={ templ.SafeURL(w.Page) } rel="noopener">{ t(ctx, "ui.read.more.on.wikipedia") }</a>
		<small class="mb-muted"> { t(ctx, "ui.text.cc.by.sa.4") }</small>
	</div>
}

templ lbFigure(it atlas.GalleryItem) {
	<figure class="art zoom" { lbAttrs(it)... } tabindex="0" role="button" aria-label={ t(ctx, "ui.enlarge", "title", it.Title) }>
		<img src={ templ.SafeURL(it.Full) } alt={ it.Title } loading="lazy"/>
		<figcaption>{ it.Title } — <a href={ templ.SafeURL(it.Page) } rel="noopener">{ it.Credit }</a></figcaption>
	</figure>
}

// gallery is a balanced mosaic: uniform tiles with a few larger ones, each opening the lightbox.
templ gallery(items []atlas.GalleryItem) {
	<div class="mosaic" data-lb-group>
		for i, it := range items {
			<button type="button" class={ "tile", templ.KV("feat", i%11 == 0 && len(items) >= 5), templ.KV("wide", i%11 == 6) } { lbAttrs(it)... }>
				<img src={ templ.SafeURL(it.Thumb) } alt={ it.Title } loading="lazy"/>
				<span class="cap">{ it.Title }</span>
			</button>
		}
	</div>
}

templ chips(refs []atlas.Ref, kind string) {
	for _, r := range refs {
		<a class="mb-chip" href={ href(kind, r.ID) }>
			{ r.Name }
			if r.Sub != "" {
				<small class="sub"> · { kindName(ctx, r.Sub) }</small>
			}
		</a>
	}
}

templ eventRows(evs []atlas.EventRef) {
	<ul class="rows">
		for _, e := range evs {
			<li><a href={ href("event", e.ID) }><span class="when">{ locDate(ctx, e.Date) }</span> { e.Title }</a></li>
		}
	</ul>
}

templ verseGroups(groups []atlas.BookVerses, total int) {
	<p class="mb-muted">{ count(ctx, "verse", total) }</p>
	for i, g := range groups {
		<details class="vg" open?={ i == 0 && len(groups) <= 3 }>
			<summary><a href={ href("book", g.BookID) }>{ g.Book }</a> <span class="mb-muted">{ fmt.Sprint(len(g.Verses)) }</span></summary>
			<div class="vlist">
				for _, v := range g.Verses {
					<a class="vref" href={ href("verse", v.ID) } title={ v.Excerpt }>{ v.Label }</a>
				}
			</div>
		</details>
	}
}

templ lifeBar(d *atlas.PersonDossier) {
	<div class="lifebar" title={ fmt.Sprintf("%s – %s", yrl(ctx, d.LifeFrom), yrl(ctx, d.LifeTo)) }>
		for _, e := range eras() {
			<span class="era" style={ eraSegStyle(e) }></span>
		}
		<i class={ templ.KV("exact", d.LifeExact) } style={ segStyle(d.Pct0, d.Pct1) }></i>
	</div>
	<div class="lifelbl">
		<span>{ t(ctx, "ui.4100.bc") }</span>
		<b style={ colorStyle(d.Era.Color) }>
			{ yrl(ctx, d.LifeFrom) } – { yrl(ctx, d.LifeTo) }
			if !d.LifeExact {
				<small> { t(ctx, "ui.as.they.appear.in.the") }</small>
			}
		</b>
		<span>{ t(ctx, "ui.ad.100") }</span>
	</div>
}

// ---------------------------------------------------------------- person

templ PersonPage(d *atlas.PersonDossier) {
	@classic(d.P.Name, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag" style={ colorStyle(d.Era.Color) }>
					if d.GroupName != "" {
						{ d.GroupName } ·&nbsp;
					}
					if d.P.Gender != "" {
						{ genderName(ctx, d.P.Gender) }
					} else {
						{ t(ctx, "ui.person") }
					}
				</div>
				<h1>{ d.P.Name }</h1>
				if d.Disambig != "" {
					<p class="sub">{ d.Disambig }</p>
				}
				if len(d.Aliases) > 0 {
					<div class="aliases"><span class="mb-muted">{ t(ctx, "ui.also.called") }</span>
						for _, n := range d.Aliases {
							<span class="alias">{ n }</span>
						}
					</div>
				}
				if d.HasLife {
					@lifeBar(d)
				}
				<div class="actions">
					<a class="mb-btn" href={ templ.SafeURL("/journeys?person=" + d.P.ID) }>{ t(ctx, "ui.journey") }</a>
					<a class="mb-btn" href={ templ.SafeURL("/tree/" + d.P.ID) }>{ t(ctx, "ui.family.tree") }</a>
					<a class="mb-btn" href={ templ.SafeURL("/lifespans?person=" + d.P.ID) }>{ t(ctx, "ui.who.was.alive") }</a>
					<a class="mb-btn" href={ templ.SafeURL("/cosmos?id=" + d.P.ID) }>{ t(ctx, "ui.in.the.cosmos") }</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					if d.Dict != "" {
						<section>
							<h2>{ t(ctx, "ui.about") }</h2>
							<div class="prose">@templ.Raw(d.Dict)</div>
						</section>
					}
					if len(d.Gallery) > 0 {
						<section>
							<h2>{ t(ctx, "ui.in.art") }</h2>
							@gallery(d.Gallery)
						</section>
					}
					if len(d.Events) > 0 {
						<section>
							<h2>{ t(ctx, "ui.timeline") }</h2>
							@eventRows(d.Events)
						</section>
					}
					if len(d.Verses) > 0 {
						<section>
							<h2>{ t(ctx, "ui.in.the.text") }</h2>
							@verseGroups(d.Verses, d.VerseCount)
						</section>
					}
				</div>
				<aside>
					if d.Wiki != nil {
						@wikiCard(d.Wiki, d.WikiPhoto)
					}
					if d.HasMap {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.places.in.their.story") }</div>
							@miniMap(d.Map, "aside")
							<div class="chiprow">@chips(d.TopPlaces, "place")</div>
						</div>
					}
					<div class="card">
						<div class="mb-tag">{ t(ctx, "ui.family") }</div>
						if d.Father != nil || d.Mother != nil {
							<h4>{ t(ctx, "ui.parents") }</h4>
							<div class="chiprow">
								if d.Father != nil {
									<a class="mb-chip" href={ href("person", d.Father.ID) }>{ d.Father.Name }</a>
								}
								if d.Mother != nil {
									<a class="mb-chip" href={ href("person", d.Mother.ID) }>{ d.Mother.Name }</a>
								}
							</div>
						}
						if len(d.Partners) > 0 {
							<h4>{ t(ctx, "ui.partners") }</h4>
							<div class="chiprow">@chips(d.Partners, "person")</div>
						}
						if len(d.Siblings) > 0 {
							<h4>{ t(ctx, "ui.siblings") }</h4>
							<div class="chiprow">@chips(d.Siblings, "person")</div>
						}
						if len(d.Children) > 0 {
							<h4>{ t(ctx, "ui.children") }</h4>
							<div class="chiprow">@chips(d.Children, "person")</div>
						}
						if d.Father == nil && d.Mother == nil && len(d.Partners) == 0 && len(d.Children) == 0 && len(d.Siblings) == 0 {
							<p class="mb-muted">{ t(ctx, "ui.no.family.recorded") }</p>
						}
					</div>
					if d.BirthPlace != nil || d.DeathPlace != nil {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.life") }</div>
							<ul class="facts">
								if d.BirthPlace != nil {
									<li>{ t(ctx, "ui.born.in") } <a href={ href("place", d.BirthPlace.ID) }>{ d.BirthPlace.Name }</a></li>
								}
								if d.DeathPlace != nil {
									<li>{ t(ctx, "ui.died.in") } <a href={ href("place", d.DeathPlace.ID) }>{ d.DeathPlace.Name }</a></li>
								}
							</ul>
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- place

templ PlacePage(d *atlas.PlaceDossier) {
	@classic(d.P.Name, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag">
					if d.Kind != "" {
						{ kindName(ctx, d.Kind) }
					} else {
						{ t(ctx, "ui.place") }
					}
				</div>
				<h1>{ d.P.Name }</h1>
				if d.Comment != "" {
					<p class="sub">{ d.Comment }</p>
				}
				<p class="mb-muted">
					{ count(ctx, "verse", d.VerseCount) }
					if d.P.Y0 != 0 || d.P.Y1 != 0 {
						{ t(ctx, "ui.mentioned") } { yrl(ctx, d.FirstYear) } – { yrl(ctx, d.LastYear) }
					}
				</p>
				if d.P.HasGeo {
					<div class="actions">
						<a class="mb-btn" href={ templ.SafeURL("/atlas?place=" + d.P.ID) }>{ t(ctx, "ui.see.it.on.the.time") }</a>
					</div>
				}
			</header>
			if d.P.HasGeo {
				@miniMap(d.Map, "wide")
			}
			<div class="cols">
				<div class="main">
					if d.Dict != "" {
						<section>
							<h2>{ t(ctx, "ui.about") }</h2>
							<div class="prose">@templ.Raw(d.Dict)</div>
						</section>
					}
					if len(d.Events) > 0 {
						<section>
							<h2>{ t(ctx, "ui.what.happened.here") }</h2>
							@eventRows(d.Events)
						</section>
					}
					if len(d.Verses) > 0 {
						<section>
							<h2>{ t(ctx, "ui.in.the.text") }</h2>
							@verseGroups(d.Verses, d.VerseCount)
						</section>
					}
				</div>
				<aside>
					if d.Wiki != nil {
						@wikiCard(d.Wiki, d.WikiPhoto)
					}
					if len(d.People) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.people.named.alongside") }</div>
							<div class="chiprow">@chips(d.People, "person")</div>
						</div>
					}
					if len(d.Born) > 0 || len(d.Died) > 0 {
						<div class="card">
							if len(d.Born) > 0 {
								<div class="mb-tag">{ t(ctx, "ui.born.here") }</div>
								<div class="chiprow">@chips(d.Born, "person")</div>
							}
							if len(d.Died) > 0 {
								<div class="mb-tag">{ t(ctx, "ui.died.here") }</div>
								<div class="chiprow">@chips(d.Died, "person")</div>
							}
						</div>
					}
					if len(d.Nearby) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.nearby.places") }</div>
							<div class="chiprow">@chips(d.Nearby, "place")</div>
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- event

templ EventPage(d *atlas.EventDossier) {
	@classic(d.E.Title, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag" style={ colorStyle(d.Era.Color) }>{ eraName(ctx, d.Era.ID, d.Era.Name) } · { locDate(ctx, d.E.Date) }</div>
				<h1>{ d.E.Title }</h1>
				<p class="mb-muted">
					if d.E.Days > 0 {
						{ t(ctx, "ui.lasting") } { durText(ctx, d.E.Days) }
					}
				</p>
				<div class="actions">
					<a class="mb-btn" href={ templ.SafeURL("/atlas?event=" + d.E.ID) }>{ t(ctx, "ui.see.it.on.the.time") }</a>
					if d.Prev != "" {
						<a class="mb-btn" href={ href("event", d.Prev) }>{ t(ctx, "ui.earlier") }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("event", d.Next) }>{ t(ctx, "ui.later") }</a>
					}
				</div>
			</header>
			if d.HasMap {
				@miniMap(d.Map, "wide")
			}
			if len(d.Gallery) == 1 {
				@lbFigure(d.Gallery[0])
			} else if len(d.Gallery) > 1 {
				@gallery(d.Gallery)
			}
			if len(d.Before) > 0 || len(d.After) > 0 {
				<div class="chain">
					<div class="col">
						<div class="mb-tag">{ t(ctx, "ui.because.of") }</div>
						@eventRows(d.Before)
					</div>
					<div class="now">{ d.E.Title }</div>
					<div class="col">
						<div class="mb-tag">{ t(ctx, "ui.led.to") }</div>
						@eventRows(d.After)
					</div>
				</div>
			}
			<div class="cols">
				<div class="main">
					if len(d.Verses) > 0 {
						<section>
							<h2>{ t(ctx, "ui.the.account") }</h2>
							for _, v := range d.Verses {
								<p class="quote"><a href={ href("verse", v.ID) }>{ v.Label }</a> { v.Text }</p>
							}
						</section>
					}
					if d.Notes != "" {
						<section>
							<h2>{ t(ctx, "ui.notes") }</h2>
							<div class="prose">@templ.Raw(atlas.Rich(d.Notes))</div>
						</section>
					}
				</div>
				<aside>
					if len(d.Participants) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.participants") }</div>
							<div class="chiprow">@chips(d.Participants, "person")</div>
						</div>
					}
					if len(d.Places) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.where") }</div>
							<div class="chiprow">@chips(d.Places, "place")</div>
						</div>
					}
					if len(d.PartOf) > 0 || len(d.Parts) > 0 {
						<div class="card">
							if len(d.PartOf) > 0 {
								<div class="mb-tag">{ t(ctx, "ui.part.of") }</div>
								@eventRows(d.PartOf)
							}
							if len(d.Parts) > 0 {
								<div class="mb-tag">{ t(ctx, "ui.includes") }</div>
								@eventRows(d.Parts)
							}
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- verse

templ VersePage(d *atlas.VerseDossier) {
	@classic(d.Label, "", withMap()) {
		<article class="dossier verse">
			<header class="hero">
				<div class="mb-tag">
					<a href={ href("book", d.Book.ID) }>{ d.Book.Name }</a> ·
					<a href={ href("chapter", d.ChapterID) }>{ t(ctx, "ui.chapter") } { fmt.Sprint(d.ChapterNum) }</a> · { locDate(ctx, d.Year) }
				</div>
				<h1>{ d.Label }</h1>
				<blockquote class="big">@templ.Raw(d.HTML)</blockquote>
				if d.Alt != "" {
					<p class="altver"><span class="mb-tag">{ t(ctx, "ui.kjv") }</span> @templ.Raw(d.Alt)</p>
				}
				<div class="actions">
					if d.Prev != "" {
						<a class="mb-btn" href={ href("verse", d.Prev) }>{ t(ctx, "ui.previous.verse") }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("verse", d.Next) }>{ t(ctx, "ui.next.verse") }</a>
					}
					<a class="mb-btn" href={ href("chapter", d.ChapterID) }>{ t(ctx, "ui.read.the.chapter") }</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					<section>
						<h2>{ t(ctx, "ui.in.context") }</h2>
						<div class="context">
							for _, c := range d.Context {
								<p class={ "v", templ.KV("cur", c.Current) }><sup><a href={ href("verse", c.ID) }>{ fmt.Sprint(c.Num) }</a></sup> @templ.Raw(c.HTML)</p>
							}
						</div>
					</section>
				</div>
				<aside>
					if len(d.Gallery) > 0 {
						@lbFigure(d.Gallery[0])
					}
					if d.HasMap {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.on.the.map") }</div>
							@miniMap(d.Map, "aside")
						</div>
					}
					if len(d.People) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.people") }</div>
							<div class="chiprow">@chips(d.People, "person")</div>
						</div>
					}
					if len(d.Places) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.places") }</div>
							<div class="chiprow">@chips(d.Places, "place")</div>
						</div>
					}
					if len(d.Events) > 0 {
						<div class="card">
							<div class="mb-tag">{ t(ctx, "ui.events.described") }</div>
							@eventRows(d.Events)
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- chapter (reading view)

templ ChapterPage(d *atlas.ChapterDossier) {
	@classic(fmt.Sprintf("%s %d", d.Book.Name, d.Num), "", withMap()) {
		<div class={ "reader", templ.KV("no-map", len(d.Map.Points) == 0) } data-chapter={ d.ID }>
			<div class="text">
				<div class="mb-tag"><a href={ href("book", d.Book.ID) }>{ d.Book.Name }</a> · { locDate(ctx, d.Years) }</div>
				<h1>{ d.Book.Name } { fmt.Sprint(d.Num) }</h1>
				<div class="actions">
					if d.Prev != "" {
						<a class="mb-btn" href={ href("chapter", d.Prev) }>◀ { d.PrevLabel }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("chapter", d.Next) }>{ d.NextLabel } ▶</a>
					}
				</div>
				if len(d.People) > 0 {
					<div class="chiprow" style="margin:.8rem 0">@chips(d.People, "person")</div>
				}
				<div class="verses">
					for _, v := range d.Verses {
						<p class="v" id={ fmt.Sprintf("v%d", v.Num) } data-id={ v.ID }>
							<sup><a href={ href("verse", v.ID) }>{ fmt.Sprint(v.Num) }</a></sup>
							@templ.Raw(v.HTML)
							for _, e := range v.Events {
								<a class="evbadge" href={ href("event", e.ID) } title={ locDate(ctx, e.Date) }>◆ { e.Title }</a>
							}
						</p>
						if v.ArtItem != nil {
							@lbFigure(*v.ArtItem)
						}
					}
				</div>
				<div class="actions" style="margin-top:2rem">
					<button class="mb-btn" id="readbtn" type="button"><span id="readbadge">{ t(ctx, "ui.mark.as.read") }</span></button>
					if d.Prev != "" {
						<a class="mb-btn" href={ href("chapter", d.Prev) }>◀ { d.PrevLabel }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("chapter", d.Next) }>{ d.NextLabel } ▶</a>
					}
				</div>
			</div>
			if len(d.Map.Points) > 0 {
				<div class="rmap">
					<div id="readmap"></div>
					<div class="rcap" id="rcap">{ t(ctx, "ui.scroll.the.text.the.map") }</div>
				</div>
			}
		</div>
		@templ.JSONScript("readdata", d.ReadData())
		<script src="/assets/js/site/progress-mark.js"></script>
		if len(d.Map.Points) > 0 {
			<script type="module" src="/assets/js/atlas/reader.js"></script>
		}
	}
}

// ---------------------------------------------------------------- book

templ BookPage(d *atlas.BookDossier) {
	@classic(d.B.Name, "", nil) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag">{ divName(ctx, d.B.Div) } · { testamentName(ctx, d.B.Testament) }</div>
				<h1>{ d.B.Name }</h1>
				<p class="mb-muted">{ count(ctx, "chapter", len(d.B.Chapters)) } · { count(ctx, "verse", d.B.Verses) } · { count(ctx, "person", d.PeopleN) } · { count(ctx, "place", d.PlacesN) }</p>
				<div class="skyline" title={ t(ctx, "ui.people.per.chapter") }>
					for _, c := range d.Chapters {
						<a href={ href("chapter", c.ID) } style={ heatStyle(c.Heat) } title={ t(ctx, "ui.chapter.tip", "book", d.B.Name, "n", c.Num, "people", c.People, "places", c.Places) }></a>
					}
				</div>
				<div class="actions">
					if d.Prev != nil {
						<a class="mb-btn" href={ href("book", d.Prev.ID) }>◀ { d.Prev.Name }</a>
					}
					if d.Next != nil {
						<a class="mb-btn" href={ href("book", d.Next.ID) }>{ d.Next.Name } ▶</a>
					}
					<a class="mb-btn" href="/canon">{ t(ctx, "ui.all.books") }</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					<section>
						<h2>{ t(ctx, "ui.chapters") }</h2>
						<ul class="rows chapters">
							for _, c := range d.Chapters {
								<li><a href={ href("chapter", c.ID) }><b>{ fmt.Sprint(c.Num) }</b> <i>{ c.Excerpt }</i></a></li>
							}
						</ul>
					</section>
				</div>
				<aside>
					<div class="card">
						<div class="mb-tag">{ t(ctx, "ui.most.present.people") }</div>
						<div class="chiprow">@chips(d.TopPeople, "person")</div>
					</div>
					<div class="card">
						<div class="mb-tag">{ t(ctx, "ui.most.named.places") }</div>
						<div class="chiprow">@chips(d.TopPlaces, "place")</div>
					</div>
				</aside>
			</div>
		</article>
	}
}
