package pages

import (
	"fmt"

	"github.com/almerlucke/metabible/pkg/atlas"
)

// ---------------------------------------------------------------- shell

templ classic(title string, active string, headExtra templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		@atlasHead(title, false) {
			if headExtra != nil {
				@headExtra
			}
		}
		<body class="mb-classic">
			@topNav(active)
			<main class="mb-page">
				{ children... }
			</main>
			<script src="/assets/js/site/site.js"></script>
		</body>
	</html>
}

templ withMap() {
	<link rel="stylesheet" href="/assets/vendor/maplibre/maplibre-gl.css"/>
	<script src="/assets/vendor/maplibre/maplibre-gl.js"></script>
}

templ miniMap(cfg atlas.MapConfig, class string) {
	<div class={ "mb-minimap", class } data-config={ cfg.JSON() }></div>
	<script type="module" src="/assets/js/atlas/minimap.js"></script>
}

// ---------------------------------------------------------------- shared pieces

templ chips(refs []atlas.Ref, kind string) {
	for _, r := range refs {
		<a class="mb-chip" href={ href(kind, r.ID) }>
			{ r.Name }
			if r.Sub != "" {
				<small class="sub"> · { r.Sub }</small>
			}
		</a>
	}
}

templ eventRows(evs []atlas.EventRef) {
	<ul class="rows">
		for _, e := range evs {
			<li><a href={ href("event", e.ID) }><span class="when">{ e.Date }</span> { e.Title }</a></li>
		}
	</ul>
}

templ verseGroups(groups []atlas.BookVerses, total int) {
	<p class="mb-muted">{ plural(total, "verse", "verses") }</p>
	for i, g := range groups {
		<details class="vg" open?={ i == 0 && len(groups) <= 3 }>
			<summary><a href={ href("book", g.BookID) }>{ g.Book }</a> <span class="mb-muted">{ fmt.Sprint(len(g.Verses)) }</span></summary>
			<div class="vlist">
				for _, v := range g.Verses {
					<a class="vref" href={ href("verse", v.ID) } title={ v.Excerpt }>{ v.Label }</a>
				}
			</div>
		</details>
	}
}

templ lifeBar(d *atlas.PersonDossier) {
	<div class="lifebar" title={ fmt.Sprintf("%s – %s", yr(d.LifeFrom), yr(d.LifeTo)) }>
		for _, e := range eras() {
			<span class="era" style={ eraSegStyle(e) }></span>
		}
		<i class={ templ.KV("exact", d.LifeExact) } style={ segStyle(d.Pct0, d.Pct1) }></i>
	</div>
	<div class="lifelbl">
		<span>4100 BC</span>
		<b style={ colorStyle(d.Era.Color) }>
			{ yr(d.LifeFrom) } – { yr(d.LifeTo) }
			if !d.LifeExact {
				<small> (as they appear in the text)</small>
			}
		</b>
		<span>AD 100</span>
	</div>
}

// ---------------------------------------------------------------- person

templ PersonPage(d *atlas.PersonDossier) {
	@classic(d.P.Name, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag" style={ colorStyle(d.Era.Color) }>
					if d.GroupName != "" {
						{ d.GroupName } ·&nbsp;
					}
					if d.P.Gender != "" {
						{ d.P.Gender }
					} else {
						Person
					}
				</div>
				<h1>{ d.P.Name }</h1>
				if d.Disambig != "" {
					<p class="sub">{ d.Disambig }</p>
				}
				if d.P.AlsoCall != "" {
					<p class="mb-muted">Also called: { d.P.AlsoCall }</p>
				}
				if d.HasLife {
					@lifeBar(d)
				}
				<div class="actions">
					<a class="mb-btn" href={ templ.SafeURL("/journeys?person=" + d.P.ID) }>🧭 Journey</a>
					<a class="mb-btn" href={ templ.SafeURL("/tree/" + d.P.ID) }>🌳 Family tree</a>
					<a class="mb-btn" href={ templ.SafeURL("/lifespans?person=" + d.P.ID) }>⌛ Who was alive?</a>
					<a class="mb-btn" href={ templ.SafeURL("/cosmos?id=" + d.P.ID) }>✨ In the cosmos</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					if d.Dict != "" {
						<section>
							<h2>About</h2>
							<div class="prose">@templ.Raw(d.Dict)</div>
						</section>
					}
					if len(d.Events) > 0 {
						<section>
							<h2>Timeline</h2>
							@eventRows(d.Events)
						</section>
					}
					if len(d.Verses) > 0 {
						<section>
							<h2>In the text</h2>
							@verseGroups(d.Verses, d.VerseCount)
						</section>
					}
				</div>
				<aside>
					if d.HasMap {
						<div class="card">
							<div class="mb-tag">Places in their story</div>
							@miniMap(d.Map, "aside")
							<div class="chiprow">@chips(d.TopPlaces, "place")</div>
						</div>
					}
					<div class="card">
						<div class="mb-tag">Family</div>
						if d.Father != nil || d.Mother != nil {
							<h4>Parents</h4>
							<div class="chiprow">
								if d.Father != nil {
									<a class="mb-chip" href={ href("person", d.Father.ID) }>{ d.Father.Name }</a>
								}
								if d.Mother != nil {
									<a class="mb-chip" href={ href("person", d.Mother.ID) }>{ d.Mother.Name }</a>
								}
							</div>
						}
						if len(d.Partners) > 0 {
							<h4>Partners</h4>
							<div class="chiprow">@chips(d.Partners, "person")</div>
						}
						if len(d.Siblings) > 0 {
							<h4>Siblings</h4>
							<div class="chiprow">@chips(d.Siblings, "person")</div>
						}
						if len(d.Children) > 0 {
							<h4>Children</h4>
							<div class="chiprow">@chips(d.Children, "person")</div>
						}
						if d.Father == nil && d.Mother == nil && len(d.Partners) == 0 && len(d.Children) == 0 && len(d.Siblings) == 0 {
							<p class="mb-muted">No family recorded.</p>
						}
					</div>
					if d.BirthPlace != nil || d.DeathPlace != nil {
						<div class="card">
							<div class="mb-tag">Life</div>
							<ul class="facts">
								if d.BirthPlace != nil {
									<li>Born in <a href={ href("place", d.BirthPlace.ID) }>{ d.BirthPlace.Name }</a></li>
								}
								if d.DeathPlace != nil {
									<li>Died in <a href={ href("place", d.DeathPlace.ID) }>{ d.DeathPlace.Name }</a></li>
								}
							</ul>
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- place

templ PlacePage(d *atlas.PlaceDossier) {
	@classic(d.P.Name, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag">
					if d.Kind != "" {
						{ d.Kind }
					} else {
						Place
					}
				</div>
				<h1>{ d.P.Name }</h1>
				if d.Comment != "" {
					<p class="sub">{ d.Comment }</p>
				}
				<p class="mb-muted">
					{ plural(d.VerseCount, "verse", "verses") }
					if d.P.Y0 != 0 || d.P.Y1 != 0 {
						· mentioned { yr(d.FirstYear) } – { yr(d.LastYear) }
					}
				</p>
				if d.P.HasGeo {
					<div class="actions">
						<a class="mb-btn" href={ templ.SafeURL("/atlas?place=" + d.P.ID) }>⏳ See it on the time atlas</a>
					</div>
				}
			</header>
			if d.P.HasGeo {
				@miniMap(d.Map, "wide")
			}
			<div class="cols">
				<div class="main">
					if d.Dict != "" {
						<section>
							<h2>About</h2>
							<div class="prose">@templ.Raw(d.Dict)</div>
						</section>
					}
					if len(d.Events) > 0 {
						<section>
							<h2>What happened here</h2>
							@eventRows(d.Events)
						</section>
					}
					if len(d.Verses) > 0 {
						<section>
							<h2>In the text</h2>
							@verseGroups(d.Verses, d.VerseCount)
						</section>
					}
				</div>
				<aside>
					if len(d.People) > 0 {
						<div class="card">
							<div class="mb-tag">People named alongside</div>
							<div class="chiprow">@chips(d.People, "person")</div>
						</div>
					}
					if len(d.Born) > 0 || len(d.Died) > 0 {
						<div class="card">
							if len(d.Born) > 0 {
								<div class="mb-tag">Born here</div>
								<div class="chiprow">@chips(d.Born, "person")</div>
							}
							if len(d.Died) > 0 {
								<div class="mb-tag">Died here</div>
								<div class="chiprow">@chips(d.Died, "person")</div>
							}
						</div>
					}
					if len(d.Nearby) > 0 {
						<div class="card">
							<div class="mb-tag">Nearby places</div>
							<div class="chiprow">@chips(d.Nearby, "place")</div>
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- event

templ EventPage(d *atlas.EventDossier) {
	@classic(d.E.Title, "", withMap()) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag" style={ colorStyle(d.Era.Color) }>{ d.Era.Name } · { d.E.Date }</div>
				<h1>{ d.E.Title }</h1>
				<p class="mb-muted">
					if d.Duration != "" {
						Lasting { d.Duration }
					}
				</p>
				<div class="actions">
					<a class="mb-btn" href={ templ.SafeURL("/atlas?event=" + d.E.ID) }>⏳ See it on the time atlas</a>
					if d.Prev != "" {
						<a class="mb-btn" href={ href("event", d.Prev) }>◀ Earlier</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("event", d.Next) }>Later ▶</a>
					}
				</div>
			</header>
			if d.HasMap {
				@miniMap(d.Map, "wide")
			}
			if len(d.Before) > 0 || len(d.After) > 0 {
				<div class="chain">
					<div class="col">
						<div class="mb-tag">Because of</div>
						@eventRows(d.Before)
					</div>
					<div class="now">{ d.E.Title }</div>
					<div class="col">
						<div class="mb-tag">Led to</div>
						@eventRows(d.After)
					</div>
				</div>
			}
			<div class="cols">
				<div class="main">
					if len(d.Verses) > 0 {
						<section>
							<h2>The account</h2>
							for _, v := range d.Verses {
								<p class="quote"><a href={ href("verse", v.ID) }>{ v.Label }</a> { v.Text }</p>
							}
						</section>
					}
					if d.Notes != "" {
						<section>
							<h2>Notes</h2>
							<div class="prose">@templ.Raw(atlas.Rich(d.Notes))</div>
						</section>
					}
				</div>
				<aside>
					if len(d.Participants) > 0 {
						<div class="card">
							<div class="mb-tag">Participants</div>
							<div class="chiprow">@chips(d.Participants, "person")</div>
						</div>
					}
					if len(d.Places) > 0 {
						<div class="card">
							<div class="mb-tag">Where</div>
							<div class="chiprow">@chips(d.Places, "place")</div>
						</div>
					}
					if len(d.PartOf) > 0 || len(d.Parts) > 0 {
						<div class="card">
							if len(d.PartOf) > 0 {
								<div class="mb-tag">Part of</div>
								@eventRows(d.PartOf)
							}
							if len(d.Parts) > 0 {
								<div class="mb-tag">Includes</div>
								@eventRows(d.Parts)
							}
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- verse

templ VersePage(d *atlas.VerseDossier) {
	@classic(d.Label, "", withMap()) {
		<article class="dossier verse">
			<header class="hero">
				<div class="mb-tag">
					<a href={ href("book", d.Book.ID) }>{ d.Book.Name }</a> ·
					<a href={ href("chapter", d.ChapterID) }>chapter { fmt.Sprint(d.ChapterNum) }</a> · { d.Year }
				</div>
				<h1>{ d.Label }</h1>
				<blockquote class="big">@templ.Raw(d.HTML)</blockquote>
				<div class="actions">
					if d.Prev != "" {
						<a class="mb-btn" href={ href("verse", d.Prev) }>◀ Previous verse</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("verse", d.Next) }>Next verse ▶</a>
					}
					<a class="mb-btn" href={ href("chapter", d.ChapterID) }>📖 Read the chapter</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					<section>
						<h2>In context</h2>
						<div class="context">
							for _, c := range d.Context {
								<p class={ "v", templ.KV("cur", c.Current) }><sup><a href={ href("verse", c.ID) }>{ fmt.Sprint(c.Num) }</a></sup> @templ.Raw(c.HTML)</p>
							}
						</div>
					</section>
				</div>
				<aside>
					if d.HasMap {
						<div class="card">
							<div class="mb-tag">On the map</div>
							@miniMap(d.Map, "aside")
						</div>
					}
					if len(d.People) > 0 {
						<div class="card">
							<div class="mb-tag">People</div>
							<div class="chiprow">@chips(d.People, "person")</div>
						</div>
					}
					if len(d.Places) > 0 {
						<div class="card">
							<div class="mb-tag">Places</div>
							<div class="chiprow">@chips(d.Places, "place")</div>
						</div>
					}
					if len(d.Events) > 0 {
						<div class="card">
							<div class="mb-tag">Events described</div>
							@eventRows(d.Events)
						</div>
					}
				</aside>
			</div>
		</article>
	}
}

// ---------------------------------------------------------------- chapter (reading view)

templ ChapterPage(d *atlas.ChapterDossier) {
	@classic(fmt.Sprintf("%s %d", d.Book.Name, d.Num), "", withMap()) {
		<div class={ "reader", templ.KV("no-map", len(d.Map.Points) == 0) }>
			<div class="text">
				<div class="mb-tag"><a href={ href("book", d.Book.ID) }>{ d.Book.Name }</a> · { d.Years }</div>
				<h1>{ d.Book.Name } { fmt.Sprint(d.Num) }</h1>
				<div class="actions">
					if d.Prev != "" {
						<a class="mb-btn" href={ href("chapter", d.Prev) }>◀ { d.PrevLabel }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("chapter", d.Next) }>{ d.NextLabel } ▶</a>
					}
				</div>
				if len(d.People) > 0 {
					<div class="chiprow" style="margin:.8rem 0">@chips(d.People, "person")</div>
				}
				<div class="verses">
					for _, v := range d.Verses {
						<p class="v" id={ fmt.Sprintf("v%d", v.Num) } data-id={ v.ID }>
							<sup><a href={ href("verse", v.ID) }>{ fmt.Sprint(v.Num) }</a></sup>
							@templ.Raw(v.HTML)
							for _, e := range v.Events {
								<a class="evbadge" href={ href("event", e.ID) } title={ e.Date }>◆ { e.Title }</a>
							}
						</p>
					}
				</div>
				<div class="actions" style="margin-top:2rem">
					if d.Prev != "" {
						<a class="mb-btn" href={ href("chapter", d.Prev) }>◀ { d.PrevLabel }</a>
					}
					if d.Next != "" {
						<a class="mb-btn" href={ href("chapter", d.Next) }>{ d.NextLabel } ▶</a>
					}
				</div>
			</div>
			if len(d.Map.Points) > 0 {
				<div class="rmap">
					<div id="readmap"></div>
					<div class="rcap" id="rcap">Scroll the text: the map follows the places.</div>
				</div>
			}
		</div>
		@templ.JSONScript("readdata", d.ReadData())
		if len(d.Map.Points) > 0 {
			<script type="module" src="/assets/js/atlas/reader.js"></script>
		}
	}
}

// ---------------------------------------------------------------- book

templ BookPage(d *atlas.BookDossier) {
	@classic(d.B.Name, "", nil) {
		<article class="dossier">
			<header class="hero">
				<div class="mb-tag">{ d.B.Div } · { d.B.Testament }</div>
				<h1>{ d.B.Name }</h1>
				<p class="mb-muted">{ plural(len(d.B.Chapters), "chapter", "chapters") } · { plural(d.B.Verses, "verse", "verses") } · { plural(d.PeopleN, "person", "people") } · { plural(d.PlacesN, "place", "places") }</p>
				<div class="skyline" title="People per chapter">
					for _, c := range d.Chapters {
						<a href={ href("chapter", c.ID) } style={ heatStyle(c.Heat) } title={ fmt.Sprintf("%s %d · %d people · %d places", d.B.Name, c.Num, c.People, c.Places) }></a>
					}
				</div>
				<div class="actions">
					if d.Prev != nil {
						<a class="mb-btn" href={ href("book", d.Prev.ID) }>◀ { d.Prev.Name }</a>
					}
					if d.Next != nil {
						<a class="mb-btn" href={ href("book", d.Next.ID) }>{ d.Next.Name } ▶</a>
					}
					<a class="mb-btn" href="/canon">📜 All books</a>
				</div>
			</header>
			<div class="cols">
				<div class="main">
					<section>
						<h2>Chapters</h2>
						<ul class="rows chapters">
							for _, c := range d.Chapters {
								<li><a href={ href("chapter", c.ID) }><b>{ fmt.Sprint(c.Num) }</b> <i>{ c.Excerpt }</i></a></li>
							}
						</ul>
					</section>
				</div>
				<aside>
					<div class="card">
						<div class="mb-tag">Most present people</div>
						<div class="chiprow">@chips(d.TopPeople, "person")</div>
					</div>
					<div class="card">
						<div class="mb-tag">Most named places</div>
						<div class="chiprow">@chips(d.TopPlaces, "place")</div>
					</div>
				</aside>
			</div>
		</article>
	}
}
