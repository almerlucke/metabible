package pages

import (
	"fmt"
	"net/url"

	"github.com/almerlucke/metabible/pkg/atlas"
)

// ---------------------------------------------------------------- books

templ BooksPage(groups []atlas.BookGroup) {
	@classic("Books", "books", nil) {
		<div class="browse">
			<div class="mb-tag">sixty-six books</div>
			<h1 class="mb-display">Books</h1>
			<p class="mb-muted lead">Each strip is the book's chapters; brighter means more people appear in that chapter. <a href="/canon">See all books side by side →</a></p>
			for i, g := range groups {
				if i == 0 || groups[i-1].Testament != g.Testament {
					<h2 class="testament">{ g.Testament }</h2>
				}
				<h3 class="div">{ g.Div }</h3>
				<div class="bookgrid">
					for _, b := range g.Books {
						<div class="bcard">
							<a class="bname" href={ href("book", b.ID) }>{ b.Name }</a>
							<div class="bstats">{ plural(b.Chapters, "chapter", "chapters") } · { plural(b.People, "person", "people") } · { plural(b.Places, "place", "places") }</div>
							<div class="skyline mini">
								for i, h := range b.Heat {
									<a href={ href("chapter", b.CIDs[i]) } style={ heatStyle(h) } title={ fmt.Sprintf("%s %d", b.Name, i+1) }></a>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

// ---------------------------------------------------------------- events

templ EventsPage(groups []atlas.EraGroup) {
	@classic("Events", "events", nil) {
		<div class="browse">
			<div class="mb-tag">four thousand years</div>
			<h1 class="mb-display">Events</h1>
			<p class="mb-muted lead">The Bible's events in order. <a href="/atlas">Watch them unfold on the map →</a></p>
			<div class="evtools">
				<input id="evq" class="mb-input" type="search" placeholder="Filter events…" autocomplete="off"/>
				<div class="erajump">
					for _, g := range groups {
						<a href={ templ.SafeURL("#" + g.Era.ID) } style={ colorStyle(g.Era.Color) }>{ g.Era.Name }</a>
					}
				</div>
			</div>
			for _, g := range groups {
				<section class="era" id={ g.Era.ID }>
					<h2 class="era-head" style={ colorStyle(g.Era.Color) }>{ g.Era.Name } <small>{ yr(g.Era.From) } – { yr(g.Era.To) } · { plural(len(g.Events), "event", "events") }</small></h2>
					<div class="tl" style={ templ.SafeCSS("--c:" + g.Era.Color) }>
						for _, e := range g.Events {
							<article class="evc" data-q={ e.Title + " " + e.Text }>
								<div class="when">
									{ e.Date }
									if e.Days != "" {
										<small> · { e.Days }</small>
									}
								</div>
								<h3><a href={ href("event", e.ID) }>{ e.Title }</a></h3>
								if e.Text != "" {
									<p class="mb-verse">
										“{ e.Text }”
										if e.VerseID != "" {
											<a class="ref" href={ href("verse", e.VerseID) }>{ e.Ref }</a>
										}
									</p>
								}
								<div class="chiprow">
									@chips(e.Places, "place")
									@chips(e.People, "person")
								</div>
							</article>
						}
					</div>
				</section>
			}
		</div>
		<script src="/assets/js/atlas/events.js"></script>
	}
}

// ---------------------------------------------------------------- concordance

templ ConcordancePage(r *atlas.ConcResult) {
	@classic("Concordance", "concordance", nil) {
		<div class="browse">
			<div class="mb-tag">search every verse</div>
			<h1 class="mb-display">Concordance</h1>
			<form class="csearch" method="get" action="/concordance">
				<input name="search" class="mb-input" type="search" placeholder='Search verses: love, "the Lord is my shepherd", grace peace…' value={ r.Query } autofocus?={ r.Query == "" }/>
				if r.BookID != "" {
					<input type="hidden" name="book" value={ r.BookID }/>
				}
				<button class="mb-btn" type="submit">Search</button>
			</form>
			if len(r.Terms) > 0 {
				<p class="mb-muted">
					{ plural(r.Total, "verse", "verses") }
					if r.BookID != "" {
						in this book · <a href={ templ.SafeURL("/concordance?search=" + url.QueryEscape(r.Query)) }>show all books</a>
					}
				</p>
				if r.Total > 0 {
					<div class="dist" title="Where it appears, book by book">
						for _, b := range r.Books {
							<a class={ templ.KV("on", b.ID == r.BookID), templ.KV("zero", b.Count == 0) } href={ templ.SafeURL("/concordance?search=" + url.QueryEscape(r.Query) + "&book=" + b.ID) } title={ fmt.Sprintf("%s: %d", b.Name, b.Count) }>
								<i style={ templ.SafeCSS(fmt.Sprintf("height:%.0f%%", 4+b.Pct*96)) }></i>
							</a>
						}
					</div>
					<div class="dist-lbl"><span>Genesis</span><span>Malachi</span><span>Matthew</span><span>Revelation</span></div>
				}
				<ol class="hits">
					for _, h := range r.Hits {
						<li><a class="loc" href={ href("verse", h.ID) }>{ h.Label }</a> @templ.Raw(h.HTML)</li>
					}
				</ol>
				if r.Capped {
					<p class="mb-muted">Showing the first { fmt.Sprint(r.Shown) }. Narrow it down by clicking a book above or adding a word.</p>
				}
				if r.Total == 0 {
					<p class="mb-muted">No verse contains all of those words.</p>
				}
			} else {
				<p class="mb-muted">Try a word, several words (all must appear), or a quoted phrase.</p>
			}
		</div>
	}
}

// ---------------------------------------------------------------- people

templ PeoplePage() {
	@classic("People", "people", nil) {
		<div class="browse wide">
			<div class="mb-tag">three thousand people</div>
			<h1 class="mb-display">People</h1>
			<div class="ptools">
				<input id="pq" class="mb-input" type="search" placeholder="Search by name…" autocomplete="off"/>
				<select id="pgroup" class="mb-input"><option value="">Any tribe or group</option></select>
				<select id="pera" class="mb-input"><option value="">Any era</option></select>
				<select id="pgender" class="mb-input">
					<option value="">Any gender</option>
					<option>Male</option>
					<option>Female</option>
				</select>
				<select id="psort" class="mb-input">
					<option value="vc">Most mentioned</option>
					<option value="az">A – Z</option>
					<option value="time">Chronological</option>
				</select>
			</div>
			<div class="az" id="paz"></div>
			<p class="mb-muted" id="pcount"></p>
			<div class="pgrid" id="pgrid"></div>
			<div id="pmore" class="more"></div>
		</div>
		<script type="module" src="/assets/js/atlas/people.js"></script>
	}
}

// ---------------------------------------------------------------- places

templ PlacesPage() {
	@immersive("Places", "places", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
		<div id="plist" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/places.js"></script>
	}
}

// ---------------------------------------------------------------- credits

templ CreditsPage(images []atlas.Credit, texts []atlas.Credit) {
	@classic("Credits", "credits", nil) {
		<div class="browse credits">
			<div class="mb-tag">standing on open work</div>
			<h1 class="mb-display">Credits &amp; licenses</h1>
			<h2>Data</h2>
			<ul>
				<li><a href="https://github.com/robertrouse/theographic-metadata" rel="noopener">Theographic Bible Metadata</a>: people, places, events, periods and verse links, CC BY-SA 4.0. This site's cleaned copy and everything derived from it is shared under the same license.</li>
				<li>Easton's Bible Dictionary (1897) supplies the descriptions of people and places. Public domain.</li>
				<li>Verse text: King James Version. Public domain.</li>
			</ul>
			<h2>Open content</h2>
			<ul>
				<li>Summaries and photographs come from <a href="https://www.wikipedia.org" rel="noopener">Wikipedia</a> and <a href="https://commons.wikimedia.org" rel="noopener">Wikimedia Commons</a>. Text is CC BY-SA 4.0; each photograph carries its own free license, shown beneath it and listed below.</li>
				<li>Engravings are by Gustave Doré (1832–1883), from <em>The Holy Bible</em> (1866). Public domain, via Wikimedia Commons.</li>
			</ul>
			<h2>Maps and software</h2>
			<ul>
				<li>Map imagery © Esri, Maxar, Earthstar Geographics and the GIS user community; night map © OpenStreetMap contributors © CARTO; elevation from the AWS Terrain Tiles (Mapzen, USGS, NASA and others).</li>
				<li><a href="https://maplibre.org" rel="noopener">MapLibre GL JS</a> (BSD-3-Clause), <a href="https://threejs.org" rel="noopener">three.js</a> (MIT), Inter and Cinzel (SIL Open Font License), <a href="https://templ.guide" rel="noopener">templ</a> (MIT).</li>
			</ul>
			if len(images) > 0 {
				<h2>Images ({ fmt.Sprint(len(images)) })</h2>
				<details>
					<summary>Show every image, author and license</summary>
					<table class="credit-table">
						for _, c := range images {
							<tr>
								<td><a href={ templ.SafeURL(c.Page) } rel="noopener">{ c.Title }</a></td>
								<td>{ c.Artist }</td>
								<td>{ c.License }</td>
							</tr>
						}
					</table>
				</details>
			}
			if len(texts) > 0 {
				<h2>Wikipedia texts ({ fmt.Sprint(len(texts))})</h2>
				<details>
					<summary>Show every article used</summary>
					<ul class="credit-list">
						for _, c := range texts {
							<li><a href={ templ.SafeURL(c.Page) } rel="noopener">{ c.Title }</a></li>
						}
					</ul>
				</details>
			}
		</div>
	}
}

// ---------------------------------------------------------------- gallery

templ GalleryPage(items []atlas.GalleryItem, engravings int, people int, places int) {
	@classic("Gallery", "gallery", nil) {
		<div class="browse wide galpage">
			<div class="mb-tag">open images</div>
			<h1 class="mb-display">Gallery</h1>
			<p class="mb-muted lead">Engravings by Gustave Doré and photographs from Wikimedia Commons. Click any picture to enlarge it, read its license and follow it to the person, event or place it belongs to.</p>
			if len(items) == 0 {
				<p class="mb-muted">No images have been fetched yet. Run <code>go run ./cmd/enrich</code>.</p>
			} else {
				<div class="galtools">
					<div class="seg2" id="galtabs">
						<button class="mb-btn on" data-f="">All { fmt.Sprint(len(items)) }</button>
						<button class="mb-btn" data-f="engraving">Engravings { fmt.Sprint(engravings) }</button>
						<button class="mb-btn" data-f="person">People { fmt.Sprint(people) }</button>
						<button class="mb-btn" data-f="place">Places { fmt.Sprint(places) }</button>
					</div>
					<input id="galq" class="mb-input" type="search" placeholder="Filter by title…" autocomplete="off"/>
				</div>
				@gallery(items)
			}
		</div>
		<script src="/assets/js/atlas/gallery.js"></script>
	}
}
