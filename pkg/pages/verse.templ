package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
    "fmt"
)

templ VersePage(book *models.Book, chapter *models.Chapter, verse *models.Verse, prevVerse string, nextVerse string) {
    <!DOCTYPE html>
    <html lang="en">
        @head(fmt.Sprintf("%s %d.%d", book.BookName, chapter.ChapterNum, verse.VerseNum)) {}
        <body>
        @mainContainer("Verse") {
            @navArticle(verseTitleComponent(book, chapter, verse), "/verse/%s",  prevVerse, nextVerse) {
                <md-block>{verse.RichText}</md-block>
            }
        }
        </body>
    </html>
}