package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
    "fmt"
)

templ PeoplePage(people []*models.Person, search string) {
    <!DOCTYPE html>
    <html lang="en">
        @head("People") {}
        <body>
        @mainContainer("People") {
            <form>
                <fieldset role="group">
                    <input name="search" type="text" placeholder="Search people" value={search} />
                    <input type="submit" value="Search" />
                </fieldset>
            </form>
            <ul>
                for _, person := range people {
                    <li><a href={templ.SafeURL(fmt.Sprintf("/person/%s", person.ID))}>{ person.ListingLabel() }</a></li>
                }
            </ul>
        }
        </body>
    </html>
}