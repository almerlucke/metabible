templ EventPage(eventInfo *EventInfo, prevEvent string, nextEvent string)  {
    <!DOCTYPE html>
    <html lang="en">
        @head(eventInfo.Event.Title) {}
        <body>
        @mainContainer("Event") {
            @navArticle(eventTitleComponent(eventInfo.Event.ListingLabel()), "/event/%s",  prevEvent, nextEvent) {
                <details open>
                    <summary>Details</summary>
                </details>
            }
        }
        </body>
    </html>
}