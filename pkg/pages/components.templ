package pages

import "strings"

// mainContainer wraps the list pages (books, people, places, events, concordance)
// in the shared top bar and page frame.
templ mainContainer(title string) {
	@topNav(strings.ToLower(title))
	<main class="mb-page list">
		<h1 class="mb-display" style="color: var(--mb-gold2)">{ title }</h1>
		{ children... }
	</main>
	<script src="/assets/js/site/site.js"></script>
}

// head renders the shared <head> for the list pages.
templ head(title string) {
	@atlasHead(title, false) {
		{ children... }
	}
}
