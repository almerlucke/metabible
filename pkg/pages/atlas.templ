package pages

import (
	"fmt"
	"strings"
)

type HomeStats struct {
	Verses int
	People int
	Places int
	Events int
}

templ atlasHead(title string, immersive bool) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="color-scheme" content="dark"/>
		<title>{ title } · { t(ctx, "site.name") }</title>
		<meta property="og:site_name" content={ t(ctx, "site.name") }/>
		<meta property="og:title" content={ title + " · " + t(ctx, "site.name") }/>
		<meta property="og:description" content={ t(ctx, "site.description") }/>
		<meta name="description" content={ t(ctx, "site.description") }/>
		<meta property="og:type" content="website"/>
		<meta property="og:image" content={ ogImage(ctx, title) }/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="theme-color" content="#080a14"/>
		<link rel="manifest" href="/assets/manifest.webmanifest"/>
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/icon-32.png"/>
		<link rel="apple-touch-icon" href="/assets/icons/icon-180.png"/>
		<link rel="stylesheet" href="/assets/vendor/fonts/fonts.css"/>
		<link rel="stylesheet" href="/assets/css/metabible.css"/>
		<script src={ "/i18n/" + langOf(ctx) + ".js" }></script>
		<script type="importmap">{"imports":{"three":"/assets/vendor/three/three.module.js","three/addons/":"/assets/vendor/three/addons/"}}</script>
		{ children... }
	</head>
}

templ topNav(active string) {
	<a class="skip" href="#main">{ t(ctx, "nav.skip") }</a>
	<nav class="mb-nav" aria-label={ t(ctx, "nav.main") }>
		<a class="mb-brand" href="/">METABIBLE</a>
		<div class="links">
			<a href="/story" class={ templ.KV("on", active == "story") }>{ t(ctx, "nav.story") }</a>
			<a href="/atlas" class={ templ.KV("on", active == "atlas") }>{ t(ctx, "nav.atlas") }</a>
			<a href="/journeys" class={ templ.KV("on", active == "journeys") }>{ t(ctx, "nav.journeys") }</a>
			<a href="/tree" class={ templ.KV("on", active == "tree") }>{ t(ctx, "nav.family") }</a>
			<a href="/cosmos" class={ templ.KV("on", active == "cosmos") }>{ t(ctx, "nav.cosmos") }</a>
			<a href="/canon" class={ templ.KV("on", active == "canon") }>{ t(ctx, "nav.canon") }</a>
		</div>
		<details class="more">
			<summary class={ templ.KV("on", active == "lifespans" || active == "migrations" || active == "gallery" || active == "themes" || active == "compare" || active == "quiz" || active == "progress") }>{ t(ctx, "nav.more") } ▾</summary>
			<div class="menu">
				<a href="/lifespans">{ t(ctx, "nav.lifespans") }</a>
				<a href="/migrations">{ t(ctx, "nav.migrations") }</a>
				<a href="/gallery">{ t(ctx, "nav.gallery") }</a>
				<a href="/themes">{ t(ctx, "nav.themes") }</a>
				<a href="/compare">{ t(ctx, "nav.compare") }</a>
				<a href="/quiz">{ t(ctx, "nav.quiz") }</a>
				<a href="/progress">{ t(ctx, "nav.progress") }</a>
			</div>
		</details>
		<span class="sep"></span>
		<div class="links secondary">
			<a href="/books" class={ templ.KV("on", active == "books") }>{ t(ctx, "nav.books") }</a>
			<a href="/people" class={ templ.KV("on", active == "people") }>{ t(ctx, "nav.people") }</a>
			<a href="/places" class={ templ.KV("on", active == "places") }>{ t(ctx, "nav.places") }</a>
			<a href="/events" class={ templ.KV("on", active == "events") }>{ t(ctx, "nav.events") }</a>
			<a href="/concordance" class={ templ.KV("on", active == "concordance") }>{ t(ctx, "nav.concordance") }</a>
			<a href="/credits" class={ templ.KV("on", active == "credits") }>{ t(ctx, "nav.credits") }</a>
		</div>
		<span class="grow"></span>
		<div class="langsw" role="group" aria-label={ t(ctx, "nav.language") }>
			for _, l := range langs() {
				<a href={ templ.SafeURL("?lang=" + l.Code) } data-lang={ l.Code } hreflang={ l.Code } lang={ l.Code } class={ templ.KV("on", l.Code == langOf(ctx)) }>{ strings.ToUpper(l.Code) }</a>
			}
		</div>
		<button class="mb-kbd" data-mb-search type="button" aria-label={ t(ctx, "nav.search") }>{ t(ctx, "nav.search") } <kbd>Ctrl K</kbd></button>
		<button class="mb-kbd" data-mb-present type="button" aria-label={ t(ctx, "nav.present") } title={ t(ctx, "nav.present.title") }>▣</button>
	</nav>
}

templ immersive(title string, active string, headExtra templ.Component) {
	<!DOCTYPE html>
	<html lang={ langOf(ctx) } data-theme="dark">
		@atlasHead(title, true) {
			if headExtra != nil {
				@headExtra
			}
		}
		<body class="mb-immersive">
			@topNav(active)
			<div class="mb-stage" id="main" role="main">
				{ children... }
			</div>
			<script src="/assets/js/site/site.js"></script>
		</body>
	</html>
}

templ mapLibreHead() {
	<link rel="stylesheet" href="/assets/vendor/maplibre/maplibre-gl.css"/>
	<script src="/assets/vendor/maplibre/maplibre-gl.js"></script>
}

templ noHead() {
}

templ HomePage(s HomeStats) {
	<!DOCTYPE html>
	<html lang={ langOf(ctx) } data-theme="dark">
		@atlasHead(t(ctx, "home.title"), false) {
		}
		<body>
			@topNav("")
			<section class="mb-hero" style="margin-top: var(--mb-nav-h)">
				<canvas id="hero"></canvas>
				<div class="inner">
					<div class="mb-tag">{ t(ctx, "site.tagline") }</div>
					<h1>METABIBLE</h1>
					<p class="lead">{ t(ctx, "home.lead") }</p>
					<a class="mb-btn" href="/story?play=1" style="font-size:1rem;padding:.7rem 1.6rem">▶ { t(ctx, "home.begin") }</a>
					<div class="mb-stats">
						<div><b>{ fmt.Sprint(s.Verses) }</b>{ t(ctx, "home.stat.verses") }</div>
						<div><b>{ fmt.Sprint(s.People) }</b>{ t(ctx, "home.stat.people") }</div>
						<div><b>{ fmt.Sprint(s.Places) }</b>{ t(ctx, "home.stat.places") }</div>
						<div><b>{ fmt.Sprint(s.Events) }</b>{ t(ctx, "home.stat.events") }</div>
					</div>
					<div class="mb-cards">
						<a class="mb-card" href="/story"><div class="ic">📖</div><b>{ t(ctx, "home.card.story.title") }</b><span>{ t(ctx, "home.card.story.text") }</span></a>
						<a class="mb-card" href="/atlas"><div class="ic">⏳</div><b>{ t(ctx, "home.card.atlas.title") }</b><span>{ t(ctx, "home.card.atlas.text") }</span></a>
						<a class="mb-card" href="/journeys"><div class="ic">🧭</div><b>{ t(ctx, "home.card.journeys.title") }</b><span>{ t(ctx, "home.card.journeys.text") }</span></a>
						<a class="mb-card" href="/tree"><div class="ic">🌳</div><b>{ t(ctx, "home.card.tree.title") }</b><span>{ t(ctx, "home.card.tree.text") }</span></a>
						<a class="mb-card" href="/cosmos"><div class="ic">✨</div><b>{ t(ctx, "home.card.cosmos.title") }</b><span>{ t(ctx, "home.card.cosmos.text") }</span></a>
						<a class="mb-card" href="/canon"><div class="ic">📜</div><b>{ t(ctx, "home.card.canon.title") }</b><span>{ t(ctx, "home.card.canon.text") }</span></a>
						<a class="mb-card" href="/migrations"><div class="ic">🔥</div><b>{ t(ctx, "home.card.migrations.title") }</b><span>{ t(ctx, "home.card.migrations.text") }</span></a>
						<a class="mb-card" href="/lifespans"><div class="ic">⌛</div><b>{ t(ctx, "home.card.lifespans.title") }</b><span>{ t(ctx, "home.card.lifespans.text") }</span></a>
					</div>
				</div>
			</section>
			<script src="/assets/js/site/site.js"></script>
			<script type="module" src="/assets/js/atlas/home.js"></script>
		</body>
	</html>
}

templ AtlasPage() {
	@immersive(t(ctx, "nav.atlas"), "atlas", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
		<div id="yearbox" class="mb-panel"></div>
		<div id="layers" class="mb-panel"></div>
		<div id="feed" class="mb-panel mb-scroll"></div>
		<div id="timeline" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/atlas.js"></script>
	}
}

