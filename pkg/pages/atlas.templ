templ ComparePage() {
	@classic("Compare", "compare", nil) {
		<div class="browse wide cmp">
			<div class="mb-tag">side by side</div>
			<h1 class="mb-display">Compare</h1>
			<p class="mb-muted lead">Pick two people or two places. See when they lived, how they are related, where their stories meet, and a short story of the connection.</p>
			<div id="cmpui"></div>
			<div id="cmpout"></div>
		</div>
		<script type="module" src="/assets/js/atlas/compare.js"></script>
	}
}

templ ThemesPage() {
	@classic("Themes", "themes", withMap()) {
		<div class="browse wide themes">
			<div class="mb-tag">follow an idea through the text</div>
			<h1 class="mb-display">Themes</h1>
			<div class="thgrid">
				<div id="thlist" class="thlist"></div>
				<div id="thmain"></div>
			</div>
		</div>
		<script type="module" src="/assets/js/atlas/themes.js"></script>
	}
}

templ ProgressPage() {
	@classic("My reading", "progress", withMap()) {
		<div class="browse wide progress">
			<div class="mb-tag">kept in this browser only</div>
			<h1 class="mb-display">My reading</h1>
			<div id="prog"></div>
		</div>
		<script type="module" src="/assets/js/atlas/progress.js"></script>
	}
}

templ QuizPage() {
	@classic("Quiz", "quiz", nil) {
		<div class="browse quiz">
			<div class="mb-tag">test what you know</div>
			<h1 class="mb-display">Quiz</h1>
			<div id="quiz"></div>
		</div>
		<script type="module" src="/assets/js/atlas/quiz.js"></script>
	}
}
