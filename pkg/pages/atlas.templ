templ ComparePage() {
	@classic(t(ctx, "nav.compare"), "compare", nil) {
		<div class="browse wide cmp">
			<div class="mb-tag">{ t(ctx, "ui.side.by.side") }</div>
			<h1 class="mb-display">{ t(ctx, "ui.compare") }</h1>
			<p class="mb-muted lead">{ t(ctx, "ui.pick.two.people.or.two") }</p>
			<div id="cmpui"></div>
			<div id="cmpout"></div>
		</div>
		<script type="module" src="/assets/js/atlas/compare.js"></script>
	}
}

