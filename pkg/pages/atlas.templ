package pages

import "fmt"

type HomeStats struct {
	Verses int
	People int
	Places int
	Events int
}

templ atlasHead(title string, immersive bool) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="color-scheme" content="dark"/>
		<title>{ title } · MetaBible</title>
		<meta property="og:site_name" content="MetaBible"/>
		<meta property="og:title" content={ title + " · MetaBible" }/>
		<meta property="og:description" content="Explore the Bible on a 3D map, through time, and through its people."/>
		<meta name="description" content="Explore the Bible on a 3D map, through time, and through its people."/>
		<meta property="og:type" content="website"/>
		<meta property="og:image" content={ ogImage(ctx, title) }/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="theme-color" content="#080a14"/>
		<link rel="manifest" href="/assets/manifest.webmanifest"/>
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/icon-32.png"/>
		<link rel="apple-touch-icon" href="/assets/icons/icon-180.png"/>
		<link rel="stylesheet" href="/assets/vendor/fonts/fonts.css"/>
		<link rel="stylesheet" href="/assets/css/metabible.css"/>
		<script type="importmap">{"imports":{"three":"/assets/vendor/three/three.module.js","three/addons/":"/assets/vendor/three/addons/"}}</script>
		{ children... }
	</head>
}

templ topNav(active string) {
	<a class="skip" href="#main">Skip to content</a>
	<nav class="mb-nav" aria-label="Main">
		<a class="mb-brand" href="/">METABIBLE</a>
		<div class="links">
			<a href="/story" class={ templ.KV("on", active == "story") }>Story</a>
			<a href="/atlas" class={ templ.KV("on", active == "atlas") }>Time Atlas</a>
			<a href="/journeys" class={ templ.KV("on", active == "journeys") }>Journeys</a>
			<a href="/tree" class={ templ.KV("on", active == "tree") }>Family</a>
			<a href="/cosmos" class={ templ.KV("on", active == "cosmos") }>Cosmos</a>
			<a href="/canon" class={ templ.KV("on", active == "canon") }>Canon</a>
		</div>
		<details class="more">
			<summary class={ templ.KV("on", active == "lifespans" || active == "migrations" || active == "themes" || active == "compare" || active == "quiz" || active == "progress") }>More ▾</summary>
			<div class="menu">
				<a href="/lifespans">Lifespans</a>
				<a href="/migrations">Migrations</a>
				<a href="/themes">Themes</a>
				<a href="/compare">Compare</a>
				<a href="/quiz">Quiz</a>
				<a href="/progress">My reading</a>
			</div>
		</details>
		<span class="sep"></span>
		<div class="links secondary">
			<a href="/books" class={ templ.KV("on", active == "books") }>Books</a>
			<a href="/people" class={ templ.KV("on", active == "people") }>People</a>
			<a href="/places" class={ templ.KV("on", active == "places") }>Places</a>
			<a href="/events" class={ templ.KV("on", active == "events") }>Events</a>
			<a href="/concordance" class={ templ.KV("on", active == "concordance") }>Concordance</a>
			<a href="/credits" class={ templ.KV("on", active == "credits") }>Credits</a>
		</div>
		<span class="grow"></span>
		<button class="mb-kbd" data-mb-search type="button" aria-label="Search">Search <kbd>Ctrl K</kbd></button>
		<button class="mb-kbd" data-mb-present type="button" aria-label="Presentation mode" title="Presentation mode (P)">▣</button>
	</nav>
}

templ immersive(title string, active string, headExtra templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		@atlasHead(title, true) {
			if headExtra != nil {
				@headExtra
			}
		}
		<body class="mb-immersive">
			@topNav(active)
			<div class="mb-stage" id="main" role="main">
				{ children... }
			</div>
			<script src="/assets/js/site/site.js"></script>
		</body>
	</html>
}

templ mapLibreHead() {
	<link rel="stylesheet" href="/assets/vendor/maplibre/maplibre-gl.css"/>
	<script src="/assets/vendor/maplibre/maplibre-gl.js"></script>
}

templ noHead() {
}

templ HomePage(s HomeStats) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		@atlasHead("The Bible, alive", false) {
		}
		<body>
			@topNav("")
			<section class="mb-hero" style="margin-top: var(--mb-nav-h)">
				<canvas id="hero"></canvas>
				<div class="inner">
					<div class="mb-tag">an interactive atlas of scripture</div>
					<h1>METABIBLE</h1>
					<p class="lead">Four thousand years, three thousand people, one thousand places. Walk the routes, follow the families, watch the story move across the map.</p>
					<a class="mb-btn" href="/story?play=1" style="font-size:1rem;padding:.7rem 1.6rem">▶ Begin the story</a>
					<div class="mb-stats">
						<div><b>{ fmt.Sprint(s.Verses) }</b>verses</div>
						<div><b>{ fmt.Sprint(s.People) }</b>people</div>
						<div><b>{ fmt.Sprint(s.Places) }</b>places</div>
						<div><b>{ fmt.Sprint(s.Events) }</b>events</div>
					</div>
					<div class="mb-cards">
						<a class="mb-card" href="/story"><div class="ic">📖</div><b>The Story</b><span>The whole Bible in order: era by era, event by event, with the verses, the map and an optional read-aloud.</span></a>
						<a class="mb-card" href="/atlas"><div class="ic">⏳</div><b>Time Atlas</b><span>Scrub from 4004 BC to AD 100 and watch events light up across a 3D relief map.</span></a>
						<a class="mb-card" href="/journeys"><div class="ic">🧭</div><b>Journeys</b><span>Abraham, the Exodus, David, Jesus, Paul — animated routes with the verses beside them.</span></a>
						<a class="mb-card" href="/tree"><div class="ic">🌳</div><b>Family Tree</b><span>From Adam to Jesus. Find how any two people in the Bible are related.</span></a>
						<a class="mb-card" href="/cosmos"><div class="ic">✨</div><b>Cosmos</b><span>A 3D constellation of every person and place, with time running upward.</span></a>
						<a class="mb-card" href="/canon"><div class="ic">📜</div><b>Canon</b><span>All 66 books as ribbons: who appears where, which books share people, and where a word lives.</span></a>
						<a class="mb-card" href="/migrations"><div class="ic">🔥</div><b>Peoples &amp; Places</b><span>Heatmaps of where the text is, century by century, and a trail for each tribe.</span></a>
						<a class="mb-card" href="/lifespans"><div class="ic">⌛</div><b>Who Was Alive?</b><span>Pick any year and see who was alive, who they overlapped with.</span></a>
					</div>
				</div>
			</section>
			<script src="/assets/js/site/site.js"></script>
			<script type="module" src="/assets/js/atlas/home.js"></script>
		</body>
	</html>
}

templ AtlasPage() {
	@immersive("Time Atlas", "atlas", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
		<div id="yearbox" class="mb-panel"></div>
		<div id="layers" class="mb-panel"></div>
		<div id="feed" class="mb-panel mb-scroll"></div>
		<div id="timeline" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/atlas.js"></script>
	}
}

templ JourneysPage() {
	@immersive("Journeys", "journeys", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
		<div id="jlist" class="mb-panel mb-scroll"></div>
		<div id="jstep" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/journeys.js"></script>
	}
}

templ TreePage(id string) {
	@immersive("Family Tree", "tree", noHead()) {
		<div id="tree" class="mb-fill" data-id={ id }></div>
		<div id="tpanel" class="mb-panel mb-scroll"></div>
		<script type="module" src="/assets/js/atlas/tree.js"></script>
	}
}

templ CosmosPage() {
	@immersive("Cosmos", "cosmos", noHead()) {
		<div id="cosmos" class="mb-fill"></div>
		<div id="cpanel" class="mb-panel"></div>
		<div id="cinfo" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/cosmos.js"></script>
	}
}

templ CanonPage() {
	@immersive("Canon", "canon", noHead()) {
		<div id="canon" class="mb-fill mb-scroll"></div>
		<script type="module" src="/assets/js/atlas/canon.js"></script>
	}
}

templ LifespansPage() {
	@immersive("Who Was Alive?", "lifespans", noHead()) {
		<div id="lifespans" class="mb-fill"></div>
		<script type="module" src="/assets/js/atlas/lifespans.js"></script>
	}
}

templ StoryPage() {
	@immersive("The Story", "story", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
		<div id="sera" class="mb-panel"></div>
		<div id="scard" class="mb-panel"></div>
		<script type="module" src="/assets/js/atlas/story.js"></script>
	}
}

templ MigrationsPage() {
	@immersive("Peoples & Places", "migrations", mapLibreHead()) {
		<div id="map" class="mb-fill"></div>
