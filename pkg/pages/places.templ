package pages

import (
    "github.com/almerlucke/metabible/pkg/models"
    "fmt"
)

templ PlacesPage(places []*models.Place, search string) {
    <!DOCTYPE html>
    <html lang="en">
        @head("places") {}
        <body>
        @mainContainer("Places") {
            <form>
                <fieldset role="group">
                    <input name="search" type="text" placeholder="Search place" value={search} />
                    <input type="submit" value="Search" />
                </fieldset>
            </form>
            <ul>
                for _, place := range places {
                    <li><a href={templ.SafeURL(fmt.Sprintf("/place/%s", place.ID))}>{ place.ListingLabel() }</a></li>
                }
            </ul>
        }
        </body>
    </html>
}