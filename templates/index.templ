package templates

import (
    "github.com/almerlucke/metabible/pkg/models"
)

templ Index(markers []*models.Place) {
    <!DOCTYPE html>
    <html>
       <head>
          <title>OSM and Leaflet</title>
          <link rel="stylesheet" href="http://cdn.leafletjs.com/leaflet-0.7.3/leaflet.css"/>
          <script src="/assets/js/htmx.min.js" type="application/javascript"></script>
          @templ.JSONScript("markers", markers)
       </head>
        <body>
            <div id="map" style="width: 900px; height: 580px"></div>
            <script src="http://cdn.leafletjs.com/leaflet-0.7.3/leaflet.js"></script>
            <script>
                const markers = JSON.parse(document.getElementById('markers').textContent);

                console.log(markers.length);

                 // Creating map options
                 var mapOptions = {
                    center: [17.385044, 78.486671],
                    zoom: 10
                 }

                 // Creating a map object
                 var map = new L.map('map', mapOptions);

                 // Creating a Layer object
                 var layer = new L.TileLayer("http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png");

                 // Adding layer to the map
                 map.addLayer(layer);

                 markers.forEach((m) => {
                    const lat = m.latitude;
                    const lon = m.longitude;

                    if (lat != '' && lon != '') {
                     L.marker([parseFloat(m.latitude), parseFloat(m.longitude)]).addTo(map)
                                                                 .bindPopup(m.displayTitle);
                    }
                 })
            </script>
        </body>
    </html>
}